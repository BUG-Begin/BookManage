// src/services/borrowService.js
import apiService from './apiService';

export const borrowService = {
  // 获取借阅记录
  getBorrows: (page = 1, limit = 10, search = '', status = '') => {
    return apiService.get('/borrows', { page, limit, search, status });
  },

  // 借书
  borrowBook: (readerId, bookId) => {
    return apiService.post('/borrows', {
      reader_id: readerId,
      book_id: bookId
    });
  },

  // 还书
  returnBook: (borrowId) => {
    return apiService.put(`/borrows/${borrowId}/return`);
  },

  // 续借
  renewBook: (borrowId, days = 15) => {
    return apiService.put(`/borrows/${borrowId}/renew`, { days });
  },

  // 获取读者借阅记录
  getReaderBorrows: (readerId) => {
    return apiService.get(`/borrows/reader/${readerId}`);
  }
};
