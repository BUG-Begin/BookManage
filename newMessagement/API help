// src/services/bookService.js
import apiService from './apiService';

export const bookService = {
  // 获取图书列表
  getBooks: (page = 1, limit = 10, search = '') => {
    return apiService.get('/books', { page, limit, search });
  },

  // 获取图书详情
  getBookById: (id) => {
    return apiService.get(`/books/${id}`);
  },

  // 创建图书
  createBook: (bookData) => {
    return apiService.post('/books', bookData);
  },

  // 更新图书
  updateBook: (id, bookData) => {
    return apiService.put(`/books/${id}`, bookData);
  },

  // 删除图书
  deleteBook: (id) => {
    return apiService.delete(`/books/${id}`);
  },

  // 获取图书统计
  getStats: () => {
    return apiService.get('/books/stats/summary');
  }
};

