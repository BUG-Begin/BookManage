// src/services/adminService.js
import apiService from './apiService';

export const adminService = {
  // 管理员登录
  login: (username, password) => {
    return apiService.post('/admins/login', { username, password });
  },

  // 获取管理员信息
  getProfile: () => {
    return apiService.get('/admins/me');
  },

  // 更新管理员信息
  updateProfile: (profileData) => {
    return apiService.put('/admins/me', profileData);
  },

  // 注销
  logout: () => {
    return apiService.post('/admins/logout');
  }
};

