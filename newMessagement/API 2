// src/components/BookManager.js
import React, { useState, useEffect } from 'react';
import { bookService } from '../services/bookService';

const BookManager = () => {
  const [books, setBooks] = useState([]);
  const [loading, setLoading] = useState(false);
  const [editingBook, setEditingBook] = useState(null);
  const [showForm, setShowForm] = useState(false);
  const [searchTerm, setSearchTerm] = useState('');

  const [formData, setFormData] = useState({
    title: '',
    author: '',
    isbn: '',
    category: '',
    publisher: '',
    publicationYear: new Date().getFullYear(),
    totalCopies: 1,
    availableCopies: 1,
    description: ''
  });

  // 获取图书列表
  const fetchBooks = async () => {
    setLoading(true);
    try {
      const data = await bookService.getAllBooks();
      setBooks(data);
    } catch (error) {
      console.error('获取图书失败:', error);
      alert('获取图书失败: ' + error.message);
    } finally {
      setLoading(false);
    }
  };

  // 创建或更新图书
  const handleSubmit = async (e) => {
    e.preventDefault();
    setLoading(true);

    try {
      if (editingBook) {
        // 更新图书
        await bookService.updateBook(editingBook.id, formData);
        alert('图书更新成功!');
      } else {
        // 创建图书
        await bookService.createBook(formData);
        alert('图书创建成功!');
      }
      
      // 重置表单
      setFormData({
        title: '',
        author: '',
        isbn: '',
        category: '',
        publisher: '',
        publicationYear: new Date().getFullYear(),
        totalCopies: 1,
        availableCopies: 1,
        description: ''
      });
      setShowForm(false);
      setEditingBook(null);
      
      // 刷新列表
      fetchBooks();
    } catch (error) {
      alert('操作失败: ' + error.message);
    } finally {
      setLoading(false);
    }
  };

  // 编辑图书
  const handleEdit = (book) => {
    setEditingBook(book);
    setFormData({
      title: book.title || '',
      author: book.author || '',
      isbn: book.isbn || '',
      category: book.category || '',
      publisher: book.publisher || '',
      publicationYear: book.publicationYear || new Date().getFullYear(),
      totalCopies: book.totalCopies || 1,
      availableCopies: book.availableCopies || 1,
      description: book.description || ''
    });
    setShowForm(true);
  };

  // 删除图书
  const handleDelete = async (id) => {
    if (window.confirm('确定要删除这本图书吗？')) {
      setLoading(true);
      try {
        await bookService.deleteBook(id);
        alert('删除成功!');
        fetchBooks();
      } catch (error) {
        alert('删除失败: ' + error.message);
      } finally {
        setLoading(false);
      }
    }
  };

  // 搜索图书
  const handleSearch = async () => {
    if (!searchTerm.trim()) {
      fetchBooks();
      return;
    }

    setLoading(true);
    try {
      const data = await bookService.searchBooks(searchTerm);
      setBooks(data);
    } catch (error) {
      console.error('搜索失败:', error);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchBooks();
  }, []);

  return (
    <div style={{ padding: '20px' }}>
      <h1>图书管理系统</h1>
      
      {/* 搜索栏 */}
      <div style={{ marginBottom: '20px', display: 'flex', gap: '10px' }}>
        <input
          type="text"
          placeholder="搜索图书..."
          value={searchTerm}
          onChange={(e) => setSearchTerm(e.target.value)}
          style={{ padding: '8px', flex: 1 }}
        />
        <button onClick={handleSearch} disabled={loading}>
          搜索
        </button>
        <button onClick={() => { setSearchTerm(''); fetchBooks(); }}>
          重置
        </button>
        <button 
          onClick={() => { setShowForm(true); setEditingBook(null); }}
          style={{ backgroundColor: '#007bff', color: 'white' }}
        >
          添加图书
        </button>
      </div>

      {/* 图书表单 */}
      {showForm && (
        <div style={{
          border: '1px solid #ddd',
          padding: '20px',
          borderRadius: '8px',
          marginBottom: '20px',
          backgroundColor: '#f8f9fa'
        }}>
          <h3>{editingBook ? '编辑图书' : '添加图书'}</h3>
          <form onSubmit={handleSubmit}>
            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '10px' }}>
              <input
                type="text"
                placeholder="书名"
                value={formData.title}
                onChange={(e) => setFormData({...formData, title: e.target.value})}
                required
              />
              <input
                type="text"
                placeholder="作者"
                value={formData.author}
                onChange={(e) => setFormData({...formData, author: e.target.value})}
                required
              />
              <input
                type="text"
                placeholder="ISBN"
                value={formData.isbn}
                onChange={(e) => setFormData({...formData, isbn: e.target.value})}
                required
              />
              <input
                type="text"
                placeholder="分类"
                value={formData.category}
                onChange={(e) => setFormData({...formData, category: e.target.value})}
              />
              <input
                type="text"
                placeholder="出版社"
                value={formData.publisher}
                onChange={(e) => setFormData({...formData, publisher: e.target.value})}
              />
              <input
                type="number"
                placeholder="出版年份"
                value={formData.publicationYear}
                onChange={(e) => setFormData({...formData, publicationYear: parseInt(e.target.value)})}
              />
              <input
                type="number"
                placeholder="总数量"
                value={formData.totalCopies}
                onChange={(e) => setFormData({...formData, totalCopies: parseInt(e.target.value)})}
                min="1"
              />
              <input
                type="number"
                placeholder="可借数量"
                value={formData.availableCopies}
                onChange={(e) => setFormData({...formData, availableCopies: parseInt(e.target.value)})}
                min="0"
              />
            </div>
            <textarea
              placeholder="图书描述"
              value={formData.description}
              onChange={(e) => setFormData({...formData, description: e.target.value})}
              style={{ width: '100%', marginTop: '10px', padding: '8px' }}
              rows="3"
            />
            <div style={{ marginTop: '10px' }}>
              <button type="submit" disabled={loading}>
                {loading ? '提交中...' : (editingBook ? '更新' : '创建')}
              </button>
              <button 
                type="button" 
                onClick={() => { setShowForm(false); setEditingBook(null); }}
                style={{ marginLeft: '10px' }}
              >
                取消
              </button>
            </div>
          </form>
        </div>
      )}

      {/* 图书列表 */}
      {loading ? (
        <div>加载中...</div>
      ) : (
        <div style={{ display: 'grid', gap: '15px' }}>
          {books.map(book => (
            <div key={book.id} style={{
              border: '1px solid #ddd',
              padding: '15px',
              borderRadius: '8px',
              backgroundColor: 'white'
            }}>
              <h3>{book.title}</h3>
              <p><strong>作者:</strong> {book.author}</p>
              <p><strong>ISBN:</strong> {book.isbn}</p>
              <p><strong>分类:</strong> {book.category}</p>
              <p><strong>出版社:</strong> {book.publisher}</p>
              <p><strong>出版年份:</strong> {book.publicationYear}</p>
              <p><strong>库存:</strong> {book.totalCopies} | <strong>可借:</strong> {book.availableCopies}</p>
              {book.description && <p><strong>描述:</strong> {book.description}</p>}
              
              <div style={{ marginTop: '10px' }}>
                <button 
                  onClick={() => handleEdit(book)}
                  style={{ marginRight: '10px', backgroundColor: '#28a745', color: 'white' }}
                >
                  编辑
                </button>
                <button 
                  onClick={() => handleDelete(book.id)}
                  style={{ backgroundColor: '#dc3545', color: 'white' }}
                >
                  删除
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
};

export default BookManager;



