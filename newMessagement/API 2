// src/services/bookService.js
import mockApi from './mockApiService';

export const bookService = {
  // 获取所有图书
  getAllBooks: () => {
    return mockApi.get('/books');
  },

  // 获取单个图书
  getBookById: (id) => {
    return mockApi.get(`/books/${id}`);
  },

  // 创建新图书
  createBook: (bookData) => {
    return mockApi.post('/books', bookData);
  },

  // 更新图书
  updateBook: (id, bookData) => {
    return mockApi.put(`/books/${id}`, bookData);
  },

  // 删除图书
  deleteBook: (id) => {
    return mockApi.delete(`/books/${id}`);
  },

  // 搜索图书（MockAPI支持查询参数）
  searchBooks: (searchTerm) => {
    return mockApi.get('/books', { search: searchTerm });
  },

  // 分页获取图书
  getBooksPaginated: (page = 1, limit = 10) => {
    return mockApi.get('/books', { page, limit });
  }
};

