// src/components/ApiTester.js
import React, { useState, useEffect } from 'react';
import { bookService } from '../services/bookService';

const ApiTester = () => {
  const [books, setBooks] = useState([]);
  const [loading, setLoading] = useState(false);
  const [message, setMessage] = useState('');

  // 测试获取所有图书
  const testGetBooks = async () => {
    setLoading(true);
    setMessage('正在获取图书...');
    try {
      const data = await bookService.getAllBooks();
      setBooks(data);
      setMessage(`成功获取 ${data.length} 本图书`);
    } catch (error) {
      setMessage(`获取失败: ${error.message}`);
      console.error('获取图书错误:', error);
    } finally {
      setLoading(false);
    }
  };

  // 测试创建图书
  const testCreateBook = async () => {
    const newBook = {
      title: '测试图书 ' + Date.now(),
      author: '测试作者',
      isbn: '978' + Math.random().toString().slice(2, 11),
      category: '技术',
      publisher: '测试出版社',
      publicationYear: 2024,
      totalCopies: 5,
      availableCopies: 5,
      description: '这是一本测试图书'
    };

    setLoading(true);
    setMessage('正在创建图书...');
    try {
      const createdBook = await bookService.createBook(newBook);
      setMessage(`创建成功! ID: ${createdBook.id}`);
      // 刷新列表
      testGetBooks();
    } catch (error) {
      setMessage(`创建失败: ${error.message}`);
    } finally {
      setLoading(false);
    }
  };

  // 测试删除图书
  const testDeleteBook = async (id) => {
    setLoading(true);
    setMessage('正在删除图书...');
    try {
      await bookService.deleteBook(id);
      setMessage('删除成功!');
      // 刷新列表
      testGetBooks();
    } catch (error) {
      setMessage(`删除失败: ${error.message}`);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    testGetBooks();
  }, []);

  return (
    <div style={{ padding: '20px', fontFamily: 'Arial, sans-serif' }}>
      <h1>MockAPI 连接测试</h1>
      
      <div style={{ marginBottom: '20px' }}>
        <button 
          onClick={testGetBooks} 
          disabled={loading}
          style={{ marginRight: '10px', padding: '10px' }}
        >
          获取图书
        </button>
        <button 
          onClick={testCreateBook} 
          disabled={loading}
          style={{ marginRight: '10px', padding: '10px' }}
        >
          创建测试图书
        </button>
      </div>

      {message && (
        <div style={{
          padding: '10px',
          backgroundColor: message.includes('成功') ? '#d4edda' : '#f8d7da',
          border: `1px solid ${message.includes('成功') ? '#c3e6cb' : '#f5c6cb'}`,
          borderRadius: '4px',
          marginBottom: '20px'
        }}>
          {message}
        </div>
      )}

      {loading && <div>加载中...</div>}

      <div>
        <h2>图书列表</h2>
        {books.length === 0 ? (
          <p>暂无图书数据</p>
        ) : (
          <div style={{ display: 'grid', gap: '15px' }}>
            {books.map(book => (
              <div key={book.id} style={{
                border: '1px solid #ddd',
                padding: '15px',
                borderRadius: '8px',
                backgroundColor: '#f9f9f9'
              }}>
                <h3>{book.title || '无标题'}</h3>
                <p><strong>作者:</strong> {book.author || '未知'}</p>
                <p><strong>ISBN:</strong> {book.isbn || '未知'}</p>
                <p><strong>分类:</strong> {book.category || '未分类'}</p>
                <p><strong>库存:</strong> {book.totalCopies || 0}</p>
                <p><strong>可借:</strong> {book.availableCopies || 0}</p>
                <button 
                  onClick={() => testDeleteBook(book.id)}
                  style={{
                    backgroundColor: '#dc3545',
                    color: 'white',
                    border: 'none',
                    padding: '5px 10px',
                    borderRadius: '4px',
                    cursor: 'pointer'
                  }}
                >
                  删除
                </button>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  );
};

export default ApiTester;


